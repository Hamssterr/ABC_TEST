# ==============================================================================
# Environment Configuration (.env)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (e.g. Supabase Postgres or local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Supabase Storage Configuration (Private bucket for generated PDF files)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=quotation-files

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=15000

# Background Job Runner Configuration
# Set JOB_PROCESSOR_ENABLED=true to run the background poller & processor (Mock Mac Processor)
JOB_POLL_INTERVAL_MS=2000
JOB_PROCESSOR_ENABLED=false



